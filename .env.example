# Deployment environment for workout-tracker.
#
# Copy this to `.env` NEXT TO docker-compose.yml ON THE DEPLOY TARGET and fill
# it in. Compose loads that file automatically; `docker compose up` substitutes
# the values into the service's `environment:` block.
#
# `.env` is gitignored and must never be committed, copied into a Markdown file,
# or pasted into an Issue or PR. Documentation says *which* keys exist and where
# the file lives — never what is in them.
#
# Every value has a safe default in docker-compose.yml, so a missing or partial
# .env degrades (mail stops working) rather than breaking a deploy.

# What emailed invite and reset links point at — the URL you actually open the
# app on. Getting this wrong mails people a link they cannot open. This is the
# single seam a public hostname replaces later (#27).
APP_BASE_URL=http://192.168.0.10:8080

# Set to 1 ONLY once something in front of the app terminates TLS. Setting it
# before that breaks login silently: the browser accepts the session cookie and
# then never sends it back, so every request looks logged out.
APP_COOKIE_SECURE=0

# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Must be a sender Resend has verified for your domain.
MAIL_FROM=Workout Tracker <you@example.com>
