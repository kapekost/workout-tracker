# Dependencies
# No trailing slash on the four below on purpose: a trailing slash matches
# directories only, so a *symlinked* node_modules/.venv (a common shortcut when a
# linked worktree reuses the main checkout's install) shows up as untracked and
# one `git add -A` commits 300MB of dependencies. A bare name matches both.
node_modules
frontend/node_modules

# Build output
frontend/dist/
static/

# Playwright test output (frontend/e2e — see playwright.config.js)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Python
__pycache__/
*.py[cod]
.venv
venv

# Runtime data (SQLite DB + volume) — never commit workout data
# Anchored to repo root so it does NOT match frontend/src/data/ (app source).
/data/
*.db
*.sqlite
*.sqlite3

# Pre-deploy safety snapshots (runbook's /api/export dumps) — real workout
# data, never belongs in a public repo.
/pre-deploy-*.json

# Env — real values live only on the deploy target, never here.
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.vscode/
.idea/

# Agent worktrees (scratch checkouts; never part of the repo)
.claude/worktrees/

# Agent execution scratch (ledgers, briefs, review packages)
.superpowers/

# Local-only deploy specifics (real host/IP/SSH/co-located services) and
# any real MCP server config — never commit either, copy from the .example
AGENTS.local.md
.mcp.json

# Per-machine agent permission grants (2026-10-02 review, finding 7). These are
# the accumulated local allowlists Claude Code and opencode write for THIS
# machine: ssh invocations naming the real deploy host and its key, tailscale
# addresses, Read grants over the owner's home directory, and pre-approved
# destructive Bash patterns. Every entry is host-specific by definition and none
# of it belongs in a public repo.
#
# .claude/settings.local.json was previously untracked but NOT ignored, so a
# single `git add -A` would have published the deploy target's LAN IP, tailnet
# IP, SSH username and key path — the exact values the history scrub
# (DECISIONS.md, 2026-09) replaced with placeholders. `git status` listed it as
# `??` for exactly that reason. Treat every line here as a hard requirement.
.claude/settings.local.json
.claude/scheduled_tasks.lock
# opencode.json
