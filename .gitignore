# Dependencies
node_modules/
frontend/node_modules/

# Build output
frontend/dist/
static/

# Playwright test output (frontend/e2e — see playwright.config.js)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Runtime data (SQLite DB + volume) — never commit workout data
# Anchored to repo root so it does NOT match frontend/src/data/ (app source).
/data/
*.db
*.sqlite
*.sqlite3

# Pre-deploy safety snapshots (runbook's /api/export dumps) — real workout
# data, never belongs in a public repo.
/pre-deploy-*.json

# Env
.env
.env.*

# Editor / OS
.DS_Store
.vscode/
.idea/

# Agent worktrees (scratch checkouts; never part of the repo)
.claude/worktrees/

# Agent execution scratch (ledgers, briefs, review packages)
.superpowers/

# Local-only deploy specifics (real host/IP/SSH/co-located services) and
# any real MCP server config — never commit either, copy from the .example
AGENTS.local.md
.mcp.json
